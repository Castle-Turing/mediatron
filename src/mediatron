#!/usr/bin/env python3
"""Mediatron wrapper: render FILE and show it in a chromeless qutebrowser.

Mediatron supplies the link policy and the house style; qutebrowser
supplies the vim grammar and the window ([m1-constraints]). The reading
profile is generated per invocation into a per-user cache basedir, so a
mediatron run never touches the resident's own qutebrowser profile.
External links are rewritten by the renderer to the mediatron-external:
scheme ([m1-links]); the wrapper registers the per-user handler that
xdg-opens their real URL, so any activation — click, hint, Enter —
opens them in the default browser.
"""
import argparse
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from mediatron_render import render, load_roots


def _cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    d = os.path.join(base, "mediatron")
    os.makedirs(d, exist_ok=True)
    return d


def _share_dir():
    env = os.environ.get("MEDIATRON_SHARE")
    if env:
        return env
    return os.path.join(HERE, "..", "..", "share", "mediatron")


def _config_file():
    env = os.environ.get("MEDIATRON_CONFIG")
    if env:
        return env
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "mediatron", "config")


EXTERNAL_SCHEME = "mediatron-external"


def _write_qb_config(basedir):
    cfg = os.path.join(basedir, "config.py")
    content = (
        "# Generated by mediatron for a reading window; do not edit.\n"
        "config.load_autoconfig(False)\n"
        "c.tabs.show = 'never'\n"
        "c.statusbar.show = 'in-mode'\n"
        "c.window.hide_decoration = True\n"
        "c.content.local_content_can_access_file_urls = True\n"
        # the handoff enabler: any activation of a mediatron-external: URL
        # (click, hint, Enter) goes to the OS's handler, which mediatron
        # registers below and which xdg-opens the real URL.
        "c.content.unknown_url_scheme_policy = 'allow-from-user-interaction'\n"
        "c.content.javascript.enabled = False\n"
    )
    with open(cfg, "w") as fh:
        fh.write(content)
    return cfg


def _install_external_handler():
    """Register the per-user handler that turns mediatron-external: URLs
    into default-browser opens. Idempotent: writes the desktop entry when
    missing or stale, and re-registers the default only when mimeapps does
    not already name it."""
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    apps_dir = os.path.join(data_home, "applications")
    os.makedirs(apps_dir, exist_ok=True)
    desktop = os.path.join(apps_dir, "mediatron-external.desktop")
    entry = (
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Name=Mediatron external link\n"
        f"Exec={os.path.normpath(os.path.join(_share_dir(), 'open-external'))} %u\n"
        f"MimeType=x-scheme-handler/{EXTERNAL_SCHEME}\n"
        "NoDisplay=true\n"
        "Terminal=false\n"
    )
    try:
        with open(desktop) as fh:
            current = fh.read()
    except OSError:
        current = ""
    if current != entry:
        with open(desktop, "w") as fh:
            fh.write(entry)
    mime_type = f"x-scheme-handler/{EXTERNAL_SCHEME}"
    query = subprocess.run(
        ["xdg-mime", "query", "default", mime_type],
        capture_output=True, text=True)
    if query.returncode != 0 or query.stdout.strip() != "mediatron-external.desktop":
        subprocess.run(["xdg-mime", "default", "mediatron-external.desktop", mime_type],
                       check=False)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="mediatron",
        description="Render a markdown file and show it in a chromeless reading window.")
    ap.add_argument("file", help="markdown file to render and show")
    ap.add_argument("--roots", help="castle-roots allowlist file (default: MEDIATRON_CONFIG or ~/.config/mediatron/config)")
    ap.add_argument("--no-open", action="store_true", help="render only, do not open the window")
    args = ap.parse_args(argv)

    file = os.path.abspath(args.file)
    if not os.path.exists(file):
        ap.error(f"no such file: {args.file}")

    roots = args.roots
    if roots is None and os.path.exists(_config_file()):
        roots = _config_file()
    out = render(file, roots=tuple(load_roots(roots)))

    if args.no_open:
        print(out)
        return

    basedir = os.path.join(_cache_dir(), "qb")
    os.makedirs(basedir, exist_ok=True)
    _install_external_handler()
    cfg = _write_qb_config(basedir)

    url = "file://" + out
    subprocess.run(["qutebrowser", "--basedir", basedir, "--config-py", cfg, url],
                   check=False)


if __name__ == "__main__":
    main()
